# ============================================================
# ACC 배포 환경변수  (cp .env.example .env 후 값 입력, .env 는 git 에 올리지 않음)
# AI 서버 API 키는 env/ai.env 에 따로 둔다 (env/ai.env.example 참고)
# ============================================================

# ---- 도커 이미지 -----------------------------------------------
# 도커 허브 계정과 태그. 받아서 쓰려면 `docker compose pull`, 소스에서 빌드하려면 `up -d --build`
ACC_REGISTRY=scv3114
ACC_TAG=20261027

# ---- 접속 주소 -------------------------------------------------
# 사용자가 브라우저에 입력하는 최종 주소. 로컬 테스트: http://localhost:5173
# 도메인 배포: https://acc.donghwan.cloud  (가비아 donghwan.cloud 의 서브도메인, docs/SETUP.md 7 참고)
PUBLIC_URL=http://localhost:5173
# 도메인(호스트명만). Caddy(GCP 직접 서빙) 사용 시에만 필요
DOMAIN=acc.donghwan.cloud
# 백엔드가 받는 CORS Origin. 비우면 PUBLIC_URL 만 허용. 로컬에서 vite 개발 서버(npm run dev)로 붙일 때만 아래처럼 넓힌다 (운영 서버에는 넣지 않는다)
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# ---- 호스트에 열 포트 ------------------------------------------
# 127.0.0.1 로 바인딩하면 외부에서 직접 접근 불가 (Cloudflare Tunnel / Caddy 뒤에 숨길 때 권장)
# 로컬에서 LAN 으로도 열려면 0.0.0.0
FRONT_BIND=127.0.0.1
FRONT_PORT=5173
# 디버깅용 백엔드 직접 접근 포트(8081). AI·DB 는 포트를 열지 않는다. 운영에서는 127.0.0.1 유지
DEBUG_BIND=127.0.0.1

# ---- DB --------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=acc_database
MYSQL_USER=acc_admin_id
MYSQL_PASSWORD=change-me

# ---- 인증 (JWT / 계정) ----------------------------------------
# JWT 서명 비밀키: 32자 이상 임의 문자열 (예: openssl rand -base64 48). 비우면 재시작마다 로그인이 풀린다
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRE_HOURS=12
# 관리자 계정 (최초 기동 시 생성, 비밀번호 8자 이상). 비우면 관리자 계정을 만들지 않는다
AUTH_ADMIN_EMAIL=admin@acc.local
AUTH_ADMIN_PASSWORD=
# "test 계정으로 로그인하기" 버튼 사용 여부. 비우면 꺼짐. 로컬 테스트·시연할 때만 true
AUTH_TEST_LOGIN_ENABLED=false

# ---- 소셜 로그인 (비우면 해당 버튼이 나오지 않는다) -------------
# 각 개발자 콘솔에 Redirect URI 등록: ${PUBLIC_URL}/auth/kakao/callback, ${PUBLIC_URL}/auth/google/callback
# 카카오: developers.kakao.com > 내 애플리케이션 > 앱 키(REST API 키), 보안(Client Secret), 카카오 로그인 > Redirect URI
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 구글: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare Tunnel (profile: tunnel) -----------------------
# Cloudflare Zero Trust > Networks > Tunnels 에서 발급한 토큰
CLOUDFLARE_TUNNEL_TOKEN=
